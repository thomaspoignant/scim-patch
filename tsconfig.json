{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "declaration": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "lib": ["es2019"],
    "types": ["mocha", "node"],
    "incremental": true,
    "allowJs": false
  },
  "compileOnSave": true,
  "include": [
    "src", "test"
  ]
}
